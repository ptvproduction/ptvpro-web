# ============================================================================
# PTV PRO SUPER APP — STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# INSTRUCTIONS:
# 1. Create a dedicated, isolated project in Supabase Cloud (e.g. "ptvpro-staging").
# 2. Copy this file to .env.staging or .env.local for staging testing.
# 3. DO NOT USE PRODUCTION SUPABASE URL OR PRODUCTION SERVICE ROLE KEYS!
# ============================================================================

# Target Environment Flag (Must be strictly "staging")
VITE_APP_ENV=staging
EXPECTED_ENVIRONMENT=staging
VITE_APP_TITLE=PTV PRO Super App (Staging)

# Isolated Staging Project Credentials (SUPABASE CLOUD STAGING ONLY)
# Replace with your staging project credentials:
VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...<staging-anon-key>

# Staging Metadata
STAGING_PROJECT_ID=<staging-project-ref>
STAGING_REGION=ap-southeast-1
